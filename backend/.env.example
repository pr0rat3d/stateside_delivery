# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stateside_deliveries
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=stateside_deliveries

# API
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Allowed frontend origin(s) for CORS, comma-separated
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Stripe (see backend/README.md "Enabling real integrations" for setup steps)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google Maps (browser key restricted by HTTP referrer; server key unrestricted/IP-restricted)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Resend (order receipt emails)
RESEND_API_KEY=your_resend_api_key_here
RECEIPT_FROM_EMAIL=Stateside Deliveries <onboarding@resend.dev>

# Sentry (error/performance monitoring)
SENTRY_DSN=your_sentry_dsn_here

# Deployment (Vercel)
VERCEL_ENV=development
